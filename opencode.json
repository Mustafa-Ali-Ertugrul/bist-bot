{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/htmlcov/**",
      "**/*.min.js",
      "**/*.lock",
      ".agentflow/**"
    ]
  },
  "provider": {
    "freemodel": {
      "options": {
        "baseURL": "https://api.freemodel.dev/v1"
      }
    }
  }
}
