# BIST Bot Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_MIN_SCORE=40

# Security & Authentication
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_BOOTSTRAP_EMAIL=admin@bistbot.com
ADMIN_BOOTSTRAP_PASSWORD_HASH=your_scrypt_or_bcrypt_hash_here
ADMIN_BOOTSTRAP_UPDATE_EXISTING=true

# Database Configuration
# Prefer DATABASE_URL (or BIST_BOT_DATABASE_URL). Empty/unset falls back to SQLite via DB_PATH.
# SQLite (local / Cloud Run ephemeral):
DB_PATH=bist_signals.db
DATABASE_URL=sqlite:///bist_signals.db
# PostgreSQL / TimescaleDB (recommended for live concurrent writers):
# DATABASE_URL=postgresql+psycopg2://bist:secret@localhost:5432/bist_bot
# BIST_BOT_DATABASE_URL=postgresql://bist:secret@localhost:5432/bist_bot
# Connection pool (PostgreSQL only):
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# Apply schema:
#   alembic upgrade head


# Server Configuration
FLASK_PORT=5001
API_BASE_URL=http://localhost:5001
# Rate limit storage defaults to memory://. Use Redis for production and multi-worker deployments.
RATE_LIMIT_STORAGE_URI=memory://
# Logging: console | json  (json for structured production logs)
LOG_FORMAT=console
LOG_LEVEL=INFO
# Critical alerts (auth failure, order rejection, circuit breaker) via Slack/generic webhook
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_TIMEOUT_SECONDS=5
# Expose /metrics without JWT for local Prometheus (docker-compose sets true)
METRICS_PUBLIC=false

# External API Keys
FREEMODEL_API_KEY=your_freemodel_api_key_here

# Midas Agent Integration
# Set MIDAS_ENABLED=true to forward signals to the Midas external service
MIDAS_API_KEY=your_midas_api_key_here
MIDAS_API_URL=https://api.midas.example.com
MIDAS_AGENT_ID=bist-bot-agent-1
MIDAS_ENABLED=false

# Broker mode: paper (simulated fills) | live (stub until integrated)
# Venue adapters: BROKER_PROVIDER=algolab
BROKER_MODE=paper
BROKER_PROVIDER=paper
# AUTO_EXECUTE=false
SHADOW_ENABLED=true
SHADOW_HOLDING_DAYS=5
SHADOW_ONLY_ROBUST=true
OUTCOME_TRACKING_ENABLED=true
# Risk - outcome tracker uses 10k notional, 1 lot; no extra config needed
# Volatilite-adaptif stop/hedef (Z2)
MIN_STOP_LOSS_PCT=1.5
ATR_TARGET_FLOOR_PCT=2.0
FALLBACK_TARGET_RR=2.0
ATR_TARGET_MULT=1.5
# CONFIRM_LIVE_TRADING=false

# Agent Mode (P0 safety flags)
# When AGENT_ENABLED=true, auto_execute is disabled; agent owns all entries.
AGENT_ENABLED=false
# paper | live
AGENT_MODE=paper
# When true, agent only enters on STRONG_BUY (never STRONG_SELL for longs)
AGENT_LONG_ONLY=true
# When true, position opened only if ExecutionAttempt.accepted=True (fill-aware)
AGENT_REQUIRE_FILL_BEFORE_POSITION=true
# Emergency: use fetched market price, not entry_price; skip with log if no price
EMERGENCY_CLOSE_ON_HALT=false
